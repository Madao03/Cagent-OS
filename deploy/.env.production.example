# ══ CagentOS 生产环境变量 ══
# 复制为 .env 并填入真实值: cp deploy/.env.production.example .env
# 权限: chmod 600 .env (只有运行用户可读)
#
# **永远不要提交 .env 到 git!**

# ──────────────────────────────────────────────────────────────
# 生产必须设置 (不设 = 不安全)
# ──────────────────────────────────────────────────────────────

# JWT 签名密钥 — 至少 32 字符的随机字符串
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 警告: 更改后所有用户需重新登录
JWT_SECRET_KEY=

# Admin API 鉴权 token
# 生成: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# ──────────────────────────────────────────────────────────────
# LLM API Keys (至少配一个)
# ──────────────────────────────────────────────────────────────

DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ──────────────────────────────────────────────────────────────
# 数据源 API Keys
# ──────────────────────────────────────────────────────────────

FRED_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
# GOOGLE_API_KEY=
# SEARCH_ENGINE_ID=

# ──────────────────────────────────────────────────────────────
# 成本控制 (上线必须确认)
# ──────────────────────────────────────────────────────────────

# 全局限额 (安全网)
COST_DAILY_TOKEN_LIMIT=500000
COST_MONTHLY_TOKEN_LIMIT=3000000

# 每用户每日限额 (主防线)
COST_USER_DAILY_TOKEN_LIMIT=100000
COST_USER_DAILY_REQUEST_LIMIT=30

# 并发限制 (防资源耗尽)
COST_USER_MAX_CONCURRENT=1
COST_GLOBAL_MAX_CONCURRENT=5

# 成本追踪 (上线后不要关)
COST_TRACKING_ENABLED=true

# ──────────────────────────────────────────────────────────────
# 可选配置
# ──────────────────────────────────────────────────────────────

DEBUG=false
