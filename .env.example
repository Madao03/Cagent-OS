# CagentOS 环境变量模板
# 复制此文件为 .env 并填入真实值:
#   cp .env.example .env
#
# **永远不要提交 .env 到 git!** 它已经在 .gitignore 里。

# ──────────────────────────────────────────────────────────────
# 必须设置(上线前)
# ──────────────────────────────────────────────────────────────

# JWT 签名密钥 — 至少 32 字符的随机字符串
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 警告: 更改后所有用户需重新登录
JWT_SECRET_KEY=

# Admin API 鉴权 token — 用于 /api/v1/admin/* 端点
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# ──────────────────────────────────────────────────────────────
# LLM API Keys(至少配一个)
# ──────────────────────────────────────────────────────────────

# DeepSeek(主用,对话 + ReAct)
DEEPSEEK_API_KEY=

# SiliconFlow(用于嵌入向量 Qwen3-Embedding-8B)
SILICONFLOW_API_KEY=

# Anthropic Claude(可选,备选 LLM)
ANTHROPIC_API_KEY=

# OpenAI(可选,备选 LLM + GPT-4V 多模态)
OPENAI_API_KEY=

# OpenRouter(可选,聚合多种模型)
OPENROUTER_API_KEY=

# ──────────────────────────────────────────────────────────────
# 数据源 API Keys(可选,功能开关)
# ──────────────────────────────────────────────────────────────

# FRED(美联储经济数据,美国宏观)
FRED_API_KEY=

# Tavily(Web 搜索)
TAVILY_API_KEY=

# Jina(AI Reader,网页清洗)
JINA_API_KEY=

# ── 成本控制（上线必须）──
# 全局限额（安全网，所有用户合计）
COST_DAILY_TOKEN_LIMIT=500000
COST_MONTHLY_TOKEN_LIMIT=3000000
# 每用户每日限额（主要防线，防止单人吃光全局）
# token: 100K ≈ 7-20 个完整问答（取决于问题复杂度）
# 请求数: 30 次
COST_USER_DAILY_TOKEN_LIMIT=100000
COST_USER_DAILY_REQUEST_LIMIT=30
# 并发限制
COST_USER_MAX_CONCURRENT=1
COST_GLOBAL_MAX_CONCURRENT=5
# 是否启用成本追踪（默认 true，上线后不要关）
COST_TRACKING_ENABLED=true

# Google Custom Search(可选,Web 搜索备选)
GOOGLE_API_KEY=
SEARCH_ENGINE_ID=

# ──────────────────────────────────────────────────────────────
# 可选配置(默认值够用)
# ──────────────────────────────────────────────────────────────

# 调试模式(开发时设 true,生产设 false 或不设)
DEBUG=false

# 对话 DB 路径(默认 ./data/conversations.db)
# CONVERSATION_DB_PATH=./data/conversations.db

# Memory DB 路径(默认 ./data/memory.db)
# MEMORY_DB_PATH=./data/memory.db

# Trace DB 路径(默认 ./data/trace.db)
# TRACE_DB_PATH=./data/trace.db
